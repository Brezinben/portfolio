{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "jest", "unicorn", "oxc", "promise", "import"],
  "jsPlugins": [
    "@stylistic/eslint-plugin",
    { "name": "anti-slop", "specifier": "./tools/oxlint/anti-slop/index.ts" },
  ],
  "env": { "browser": true, "es2024": true },
  "options": { "typeAware": true },
  "categories": {
    "correctness": "error",
    "perf": "error",
    "style": "error",
    "suspicious": "error",
    "pedantic": "warn",
  },
  "rules": {
    "anti-slop/max-lines-per-comment-block": "error",
    "anti-slop/no-boolean-flag-parameter": "error",
    // La cible ES2024 n'a pas les helpers d'itérateur que la règle propose.
    "anti-slop/no-array-filter-map": "off",
    "anti-slop/no-reduce-accumulator-copy": "error",
    // @stylistic/padding-line-between-statements porte déjà l'espacement de la maison.
    "anti-slop/require-readable-spacing": "off",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error",
    "@stylistic/line-comment-position": "error",
    "@stylistic/lines-around-comment": [
      "error",
      {
        "beforeBlockComment": true,
        "beforeLineComment": false,
        "afterBlockComment": false,
        "afterLineComment": false,
        "allowBlockStart": true,
        "allowBlockEnd": true,
        "allowObjectStart": true,
        "allowObjectEnd": true,
        "allowArrayStart": true,
        "allowArrayEnd": true,
        "allowClassStart": true,
        "allowClassEnd": true,
        "allowEnumStart": true,
        "allowEnumEnd": true,
        "allowInterfaceStart": true,
        "allowInterfaceEnd": true,
        "allowModuleStart": true,
        "allowModuleEnd": true,
        "allowTypeStart": true,
        "allowTypeEnd": true,
        "ignorePattern": "^\\s*(eslint|oxlint|prettier|oxfmt|@ts-)",
      },
    ],
    "@stylistic/padding-line-between-statements": [
      "error",
      { "blankLine": "always", "prev": "*", "next": "if" },
      { "blankLine": "always", "prev": "*", "next": "return" },
      { "blankLine": "always", "prev": "*", "next": ["class", "function"] },
      { "blankLine": "always", "prev": ["class", "function"], "next": "*" },
      { "blankLine": "always", "prev": "*", "next": "break" },
      { "blankLine": "always", "prev": "*", "next": "throw" },
      { "blankLine": "always", "prev": ["const", "let", "var"], "next": "*" },
      { "blankLine": "any", "prev": ["const", "let", "var"], "next": ["const", "let", "var"] },
      { "blankLine": "never", "prev": "singleline-const", "next": "singleline-const" },
    ],
    "@stylistic/spaced-comment": [
      "error",
      "always",
      { "markers": ["/"], "exceptions": ["-", "+", "*"] },
    ],
    // Braces always: a returned object literal needs parentheses that get removed by mistake.
    "arrow-body-style": ["error", "always"],
    "capitalized-comments": ["error", "always", { "ignoreConsecutiveComments": true }],
    "complexity": "error",
    "default-case": "error",
    "no-cond-assign": ["error", "always"],
    "no-console": "error",
    "no-use-before-define": "error",
    // Named helpers are declarations; callbacks stay arrows. The style category defaults to expressions.
    "func-style": ["error", "declaration", { "allowArrowFunctions": true }],
    // `!!value` reads as a boolean cast; other implicit coercions hide intent.
    "no-implicit-coercion": ["error", { "boolean": false }],
    // A leading underscore marks a parameter or binding kept on purpose.
    "no-unused-vars": ["error", { "varsIgnorePattern": "^_", "argsIgnorePattern": "^_" }],
    // import/no-duplicates covers it and allows a separate `import type` from the same module.
    "no-duplicate-imports": "off",
    "import/no-webpack-loader-syntax": "error",
    // An index that re-exports a folder hides where code lives and defeats tree shaking.
    "oxc/no-barrel-file": "error",
    "promise/catch-or-return": "error",
    // Both method forms are fine; the rule only picks one.
    "typescript/method-signature-style": "off",
    // Every type assertion already has a SAFETY comment required by anti-slop/require-safety-comment-for-type-assertion.
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/strict-boolean-expressions": [
      "error",
      { "allowNullableBoolean": true, "allowNullableString": true },
    ],
    "import/no-cycle": "error",
    "max-statements": ["error", 20],
    // It fires on every literal, including 0, 1 and array indexes.
    "no-magic-numbers": "off",
    // It bans the ternary operator outright.
    "no-ternary": "off",
    // Named exports are the convention: these rules push toward default exports or one export block.
    "import/no-named-export": "off",
    "import/prefer-default-export": "off",
    "import/group-exports": "off",
    "import/exports-last": "off",
    // It flags short names that read well in a small scope: i, x, e.
    "id-length": "off",
    // One declaration per statement reads better than a merged one.
    "eslint/one-var": "off",
    // The specifier style changes nothing in the output unless tsconfig sets verbatimModuleSyntax (see lint.md).
    "import/consistent-type-specifier-style": "off",
    // The formatter decides the case of number literals.
    "unicorn/number-literal-case": "off",
    // Awaiting in a loop is often the intent: sequential calls, rate limits, ordered side effects.
    "no-await-in-loop": "off",
    // Leading underscores are a naming convention, not a defect.
    "no-underscore-dangle": "off",
    // An if/else often reads better than the ternary the rule asks for.
    "unicorn/prefer-ternary": "off",
    // Both `type` and `interface` are fine; the rule only picks one.
    "typescript/consistent-type-definitions": "off",
    // The rule sorts by the first member name, which scatters the library and local import groups.
    "sort-imports": "off",
    // DOM APIs take and return null.
    "unicorn/no-null": "off",
    // DOM types are mutable, so almost no parameter can be deeply readonly.
    "typescript/prefer-readonly-parameter-types": "off",
    // getElementById is the direct API for an id lookup.
    "unicorn/prefer-query-selector": "off",
    // Stylesheets are imported for their side effects.
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }],
    "eqeqeq": "error",
    "require-await": "error",
    "import/no-nodejs-modules": "error",
    "typescript/no-confusing-void-expression": "error",
    "typescript/prefer-nullish-coalescing": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "unicorn/no-negated-condition": "error",
    // Les dessins de la page n'emploient que des glyphes d'un seul point de code : un point
    // de code y vaut une case, et le découpage par graphème n'apporterait rien.
    "typescript/no-misused-spread": "off",
    // « it » de node:test rend une promesse que le lanceur attend lui-même.
    "typescript/no-floating-promises": [
      "error",
      {
        "allowForKnownSafeCalls": [
          { "from": "package", "package": "node:test", "name": ["describe", "it", "test"] },
        ],
      },
    ],
    // L'ordre des déclarations suit leurs dépendances : une constante lit souvent celle du dessus.
    "sort-vars": "off",
    // Elle contredit consistent-return et init-declarations, qui exigent un « undefined » explicite.
    "unicorn/no-useless-undefined": "off",
    // max-statements et complexity bornent déjà la taille d'une fonction.
    "max-lines-per-function": "off",
    // Le découpage en fichiers suit les contextes de CONTEXT-MAP.md, pas un compte de lignes.
    "max-lines": "off",
    // Le point d'entrée compose toutes les tranches de la coquille : il les importe toutes.
    "import/max-dependencies": "off",
    // Elle compte aussi les conditions des rappels (filter, page.evaluate), pas seulement le test.
    "jest/no-conditional-in-test": "off",
    // Un rappel async qui rend une promesse sous condition l'attend : sinon require-await et
    // await-thenable se contredisent sur Promise.all.
    "typescript/return-await": ["error", "always"],
    // parseFloat lit les longueurs CSS (« 12px ») : Number y rend NaN.
    "unicorn/prefer-number-coercion": "off",
    // Un Element hors HTML et un Locator de Playwright n'ont pas de dataset.
    "unicorn/prefer-dom-node-dataset": "off",
    // Un tableau de cas lu par it.each cache le scénario que chaque test raconte.
    "jest/prefer-each": "off",
    // bun test n'a pas besoin d'un hook pour préparer l'état au niveau du module.
    "jest/require-hook": "off",
  },
  "ignorePatterns": [
    ".agents/**",
    ".claude/**",
    "dist*/**",
    ".versions/**",
    "node_modules/**",
    "playwright-report/**",
    "src/vendor/**",
    "docs/mascotte/**",
    "test-results/**",
    "tools/oxlint/anti-slop/**",
  ],
  "overrides": [
    {
      "files": ["tests/unit/**"],
      "rules": {
        "jest/consistent-test-it": ["error", { "fn": "it" }],
      },
    },
    {
      "files": ["src/terminal/shell.ts"],
      "rules": {
        "import/consistent-type-specifier-style": ["error", "prefer-top-level"],
      },
    },
    {
      "files": ["tests/**", "tools/**", "playwright.config.js"],
      "env": {
        "node": true,
      },
      "rules": {
        "import/no-nodejs-modules": "off",
        // Un outil en ligne de commande parle sur la console.
        "no-console": "off",
      },
    },
    {
      "files": ["tests/**"],
      "rules": {
        // Un scénario de test se lit d'un bloc : le découper disperserait ses étapes.
        "max-statements": "off",
        "eslint/no-duplicate-imports": "off",
      },
    },
  ],
}
