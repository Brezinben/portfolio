  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@oxlint/plugins": "^1.81.0",
    "@playwright/test": "1.63.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "html-minifier-terser": "^7.2.0",
    "rolldown": "^1.2.7"
  }
}
