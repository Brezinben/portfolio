{
  "configVersion": "2.2",
  "$schema": "https://github.com/jayu/rev-dep/blob/master/config-schema/2.2.schema.json?raw=true",
  "failOnEmptyWorkspace": true,
  "ignoreFiles": [".claude/**", "dist*/**", "src/vendor/**", "tools/oxlint/anti-slop/**"],
  "nodeModulesResolution": {
    "resolutionType": "entry-package",
    "includeDevDepsFromRoot": false,
  },
  "workspaces": [
    {
      "path": ".",
      "prodEntryPoints": ["src/app.ts", "src/404.ts"],
      "devEntryPoints": ["tests/**", "tools/*.ts", ".config/*.config.ts", "**/*.d.ts"],
      "moduleBoundaries": [
        {
          "name": "interpreteur",
          "pattern": "src/interpret/**/*",
          "deny": ["src/terminal/**/*", "src/app.ts"],
        },
        { "name": "coquille", "pattern": "src/terminal/**/*", "deny": ["src/interpret/**/*"] },
      ],
      "circularImportsDetection": { "enabled": true, "ignoreTypeImports": true },
      "orphanFilesDetection": true,
      "unresolvedImportsDetection": true,
      "unusedExportsDetection": { "enabled": true, "ignoreTypeExports": true },
      "unusedNodeModulesDetection": {
        "enabled": true,
        "excludeModules": [
          "@types/**",
          "@oxlint/plugins",
          "@stryker-mutator/core",
          "@stylistic/eslint-plugin",
          "npm-check-updates",
          "oxfmt",
          "oxlint",
          "oxlint-tsgolint",
          "rev-dep",
          "typescript",
        ],
      },
    },
  ],
}
