{
  "name": "portfolio",
  "version": "0.0.0",
  "private": true,
  "description": "Portfolio de Benjamin David. Pages statiques, contenu externalisé en JSON.",
  "type": "module",
  "scripts": {
    "build": "node tools/build.js",
    "lint": "npx oxlint",
