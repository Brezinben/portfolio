{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  // La liste remplace les plugins par défaut. Sans « typescript », aucune règle de types
  // ne tourne, et « typeAware » ne sert à rien.
  "plugins": ["typescript", "jest", "unicorn", "oxc", "promise", "import"],
  "jsPlugins": [
    "@stylistic/eslint-plugin",
    {
      "name": "anti-slop",
      "specifier": "./tools/oxlint/anti-slop/index.ts",
    },
  ],
  "env": {
    "browser": true,
    "es2024": true,
  },
  "options": {
    "typeAware": true,
  },
  "categories": {
    "correctness": "error",
    "perf": "error",
    "style": "error",
    "suspicious": "error",
  },
  "rules": {
    "anti-slop/max-lines-per-comment-block": "error",
    "anti-slop/no-boolean-flag-parameter": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error",
    "@stylistic/line-comment-position": "error",
    "@stylistic/lines-around-comment": [
      "error",
      {
        "beforeBlockComment": true,
        "beforeLineComment": false,
        "afterBlockComment": false,
        "afterLineComment": false,
        "allowBlockStart": true,
        "allowBlockEnd": true,
        "allowObjectStart": true,
        "allowObjectEnd": true,
        "allowArrayStart": true,
        "allowArrayEnd": true,
        "allowClassStart": true,
        "allowClassEnd": true,
        "allowEnumStart": true,
        "allowEnumEnd": true,
        "allowInterfaceStart": true,
        "allowInterfaceEnd": true,
        "allowModuleStart": true,
        "allowModuleEnd": true,
        "allowTypeStart": true,
        "allowTypeEnd": true,
        "ignorePattern": "^\\s*(eslint|oxlint|prettier|oxfmt|@ts-)",
      },
    ],
    "@stylistic/padding-line-between-statements": [
      "error",
      {
        "blankLine": "always",
        "prev": "*",
        "next": "if",
      },
      {
        "blankLine": "always",
        "prev": "*",
        "next": "return",
      },
      {
        "blankLine": "always",
        "prev": "*",
        "next": ["class", "function"],
      },
      {
        "blankLine": "always",
        "prev": ["class", "function"],
        "next": "*",
      },
      {
        "blankLine": "always",
        "prev": "*",
        "next": "break",
      },
      {
        "blankLine": "always",
        "prev": "*",
        "next": "throw",
      },
      {
        "blankLine": "always",
        "prev": ["const", "let", "var"],
        "next": "*",
      },
      {
        "blankLine": "any",
        "prev": ["const", "let", "var"],
        "next": ["const", "let", "var"],
      },
      {
        "blankLine": "never",
        "prev": "singleline-const",
        "next": "singleline-const",
      },
    ],
    "@stylistic/spaced-comment": [
      "error",
      "always",
      {
        "markers": ["/"],
        "exceptions": ["-", "+", "*"],
      },
    ],
    // Une fonction porte ses accolades et son return, rappel d'une ligne compris. La forme
    // courte faisait lire deux styles dans un meme fichier, et l'objet qu'elle rend demande
    // une paire de parentheses qu'on retire par erreur : l'objet devient alors un bloc.
    "arrow-body-style": ["error", "always"],
    "capitalized-comments": [
      "error",
      "always",
      {
        "ignoreConsecutiveComments": true,
      },
    ],
    "complexity": "error",
    "default-case": "error",
    "eqeqeq": "error",
    "no-cond-assign": ["error", "always"],
    "no-console": "error",
    "no-use-before-define": "error",
    "require-await": "error",
    "typescript/method-signature-style": "off",
    // Chaque assertion de type porte déjà un commentaire SAFETY, exigé par
    // anti-slop/require-safety-comment-for-type-assertion. Cette règle doublerait le contrôle.
    "typescript/no-unsafe-type-assertion": "off",
    // Les dessins de la page n'emploient que des glyphes d'un seul point de code : un point
    // de code y vaut une case, et le découpage par graphème n'apporterait rien.
    "typescript/no-misused-spread": "off",
    "typescript/no-confusing-void-expression": "error",
    // « it » de node:test rend une promesse que le lanceur attend lui-même.
    "typescript/no-floating-promises": [
      "error",
      {
        "allowForKnownSafeCalls": [
          { "from": "package", "package": "node:test", "name": ["describe", "it", "test"] },
        ],
      },
    ],
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/prefer-nullish-coalescing": "error",
    "typescript/strict-boolean-expressions": [
      "error",
      { "allowNullableBoolean": true, "allowNullableString": true },
    ],
    "typescript/switch-exhaustiveness-check": "error",
    "unicorn/no-negated-condition": "error",
    "import/no-nodejs-modules": "error",
    "no-magic-numbers": "off",
    "no-ternary": "off",
    "import/no-named-export": "off",
    "import/prefer-default-export": "off",
    "import/group-exports": "off",
    "import/exports-last": "off",
    "id-length": "off",
    "eslint/one-var": "off",
    "import/no-cycle": "error",
    "jest/prefer-each": "off",
    "jest/require-hook": "off",
    "import/consistent-type-specifier-style": "off",
    "max-statements": "off",
    "unicorn/number-literal-case": "off",
  },
  "ignorePatterns": [
    ".agents/**",
    ".claude/**",
    "dist*/**",
    ".versions/**",
    "node_modules/**",
    "playwright-report/**",
    "src/vendor/**",
    "docs/mascotte/**",
    "test-results/**",
    "tools/oxlint/anti-slop/**",
  ],
  "overrides": [
    {
      "files": ["tests/unit/**"],
      "rules": {
        "jest/consistent-test-it": ["error", { "fn": "it" }],
      },
    },
    {
      "files": ["src/terminal/shell.ts"],
      "rules": {
        "import/consistent-type-specifier-style": ["error", "prefer-top-level"],
      },
    },
    {
      "files": ["tests/**", "tools/**", "playwright.config.js"],
      "env": {
        "node": true,
      },
      "rules": {
        "import/no-nodejs-modules": "off",
        // Un outil en ligne de commande parle sur la console.
        "no-console": "off",
      },
    },
    {
      "files": ["tests/**"],
      "rules": {
        "eslint/no-duplicate-imports": "off",
      },
    },
  ],
}
