{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "plugins": ["unicorn", "oxc", "promise", "import"],
  "jsPlugins": ["@stylistic/eslint-plugin"],
  "env": {
    "browser": true,
    "es2024": true
  },
  "globals": {
    "Alpine": "readonly",
    "umami": "readonly"
  },
  "categories": {
    "correctness": "error",
    "perf": "error",
    "style": "error",
    "suspicious": "error"
  },
  "rules": {
    "@stylistic/padding-line-between-statements": [
      "error",
      {
        "blankLine": "always",
        "prev": "*",
        "next": "if"
      },
      {
        "blankLine": "always",
        "prev": "*",
        "next": "return"
      },
      {
        "blankLine": "always",
        "prev": "*",
        "next": ["class", "function"]
      },
      {
        "blankLine": "always",
        "prev": ["class", "function"],
        "next": "*"
      },
      {
        "blankLine": "always",
        "prev": "*",
        "next": "break"
      },
      {
        "blankLine": "always",
        "prev": "*",
        "next": "throw"
      },
      {
        "blankLine": "always",
        "prev": ["const", "let", "var"],
        "next": "*"
      },
      {
        "blankLine": "any",
        "prev": ["const", "let", "var"],
        "next": ["const", "let", "var"]
      }
    ],
    "@stylistic/spaced-comment": [
      "error",
      "always",
      {
        "markers": ["/"],
        "exceptions": ["-", "+", "*"]
      }
    ],
    "capitalized-comments": [
      "warn",
      "always",
      {
        "ignoreConsecutiveComments": true
      }
    ],
    "eqeqeq": "error",
    "import/no-nodejs-modules": "error",
    "no-magic-numbers": "off",
    "no-ternary": "off",
    "import/no-named-export": "off",
    "import/prefer-default-export": "off",
    "import/group-exports": "off",
    "import/exports-last": "off",
    "one-var": "off",
    "id-length": "off",
    "max-statements": "off"
  },
  "ignorePatterns": [
    "design/**",
    "node_modules/**",
    "playwright-report/**",
    "production/vendor/**",
    "test-results/**"
  ],
  "overrides": [
    {
      "files": ["tests/**", "playwright.config.js"],
      "env": {
        "node": true
      },
      "rules": {
        "import/no-nodejs-modules": "off"
      }
    }
  ]
}
