{
  "name": "portfolio",
  "version": "0.0.0",
  "private": true,
  "description": "Portfolio de Benjamin David. Pages statiques, contenu externalisé en JSON.",
  "type": "module",
  "scripts": {
    "build": "bun tools/build.ts",
    "check": "hk check --all",
    "deps": "npm-check-updates --interactive --format group",
    "format": "oxfmt .",
    "lint": "oxlint --deny-warnings",
    "test": "bun test tests/unit/",
    "test:browser": "playwright test -c .config/playwright.config.ts",
    "test:mutation": "stryker run .config/stryker.config.json",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@oxlint/plugins": "1.91.0",
    "@playwright/test": "1.64.1",
    "@stryker-mutator/core": "10.1.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/dom-chromium-ai": "0.0.18",
    "@types/node": "26.6.6",
    "html-minifier-terser": "7.2.0",
    "npm-check-updates": "23.1.1",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "rev-dep": "3.3.0",
    "rolldown": "1.2.16",
    "typescript": "7.0.2"
  }
}
