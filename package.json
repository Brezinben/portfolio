{
  "name": "portfolio",
  "version": "0.0.0",
  "private": true,
  "description": "Portfolio de Benjamin David. Pages statiques, contenu externalisé en JSON.",
  "type": "module",
  "scripts": {
    "build": "bun tools/build.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "npx oxlint --fix --format=agent",
    "test": "bun run typecheck && bun run test:unit",
    "test:browser": "playwright test",
    "test:unit": "bun test tests/unit/",
    "typecheck": "tsc --noEmit",
    "test:mutation": "bunx @stryker-mutator/core@10.0.0 run"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@oxlint/plugins": "^1.81.0",
    "@playwright/test": "1.63.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/dom-chromium-ai": "0.0.17",
    "@types/node": "^26.4.1",
    "html-minifier-terser": "^7.2.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2003",
    "rolldown": "^1.2.7",
    "typescript": "^7.0.2"
  }
}
