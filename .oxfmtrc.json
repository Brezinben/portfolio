{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "ignorePatterns": [
    "**/*.md",
    ".agents/**",
    ".claude/**",
    "design/**",
    "dist*/**",
    ".versions/**",
    "src/**/*.html",
    "src/content.json",
    "src/vendor/**",
    "tests/**/*-snapshots/**",
    "docs/mascotte/**",
    "tools/oxlint/anti-slop/**"
  ]
}
